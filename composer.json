{
    "name": "pantheon-upstreams/drupal-composer-managed",
    "description": "Install Drupal 9 with Composer on Pantheon.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "path",
            "url": "upstream-configuration"
        }
    ],
    "require": {
        "pantheon-upstreams/upstream-configuration": "dev-main",
        "composer/installers": "^1.9",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-recommended": "^11",
        "pantheon-systems/drupal-integrations": "^11",
        "cweagans/composer-patches": "^1.7",
        "drush/drush": "^13",
        "drupal/admin_toolbar": "^3.6",
        "drupal/domain": "^3.0@beta",
        "drupal/webform": "^6.3@RC",
        "drupal/simple_sitemap": "^4.2",
        "drupal/domain_simple_sitemap": "^3.0@RC",
        "drupal/token": "^1.17",
        "drupal/token_filter": "^2.2",
        "drupal/metatag": "^2.1",
        "drupal/feeds": "^3.0@RC",
        "drupal/tamper": "^1.0@alpha",
        "drupal/feeds_tamper": "^2.0@RC",
        "drupal/taxonomy_menu": "^3.8",
        "drupal/pathauto": "^1.15",
        "drupal/taxonomy_import": "^2.1",
        "drupal/auto_entitylabel": "^3.2",
        "drupal/geolocation": "^3.14",
        "drupal/fontyourface": "^4.2",
        "drupal/fontawesome": "^3.0",
        "drupal/fontawesome_menu_icons": "^3.0",
        "drupal/adsense": "^1.5",
        "drupal/asset_injector": "^2.21",
        "drupal/address": "^2.0",
        "drupal/sendgrid_integration": "^2.3",
        "drupal/honeypot": "^2.2",
        "drupal/google_tag": "^2.0",
        "drupal/ajax_loader": "^2.1",
        "drupal/better_exposed_filters": "^7.0",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_data_export": "^1.5",
        "drupal/views_bootstrap": "^5.5@RC",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_conditional": "^1.10",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/realname": "^2.0",
        "drupal/editor_advanced_link": "^2.3",
        "drupal/group": "^3.3",
        "drupal/group_content_menu": "^3.0",
        "drupal/dxpr_theme": "^8.1.4",
        "drupal/dxpr_theme_helper": "^3.1",
        "drupal/masquerade": "^2.0",
        "drupal/subgroup": "^3.1",
        "drupal/external_entities": "^3.0@RC",
        "drupal/book": "^2.0 || ^3.0",
        "drupal/gin": "^4.1 || ^5.0",
        "drupal/gin_toolbar": "^2.1 || ^3.0",
        "drupal/gin_login": "^2.1",
        "drupal/bootstrap_layout_builder": "^2.2",
        "drupal/ai": "^1.3",
        "drupal/ai_search": "~1.3@alpha",
        "drupal/key": "^1.22",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/ai_agents": "^1.3.2",
        "drupal/menu_link_attributes": "^1.7",
        "drupal/ai_vdb_provider_qdrant": "1.0.x-dev@dev",
        "drupal/ai_provider_litellm": "^1.2",
        "drupal/field_group": "^4.0",
        "drupal/classy": "^2.0",
        "drupal/entity_print": "^2.18",
        "drupal/webform_content_creator": "^4.0",
        "drupal/social_media_links": "^2.10"
    },
    "require-dev": {
        "drupal/core-dev": "^11"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "./web"
            },
            "allowed-packages": ["pantheon-systems/drupal-integrations"],
            "file-mapping": {
                "[project-root]/.editorconfig": false,
                "[project-root]/pantheon.upstream.yml": false,
                "[project-root]/.gitattributes": false
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"],
            "web/private/scripts/quicksilver/{$name}/": ["type:quicksilver-script"]
        },
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "enable-patching": true,
        "patches": {
            "drupal/feeds": {
                "Fix Feeds NULL mappings in MappingForm": "patches/feeds-null-mappings.patch"
            },
            "drupal/sendgrid_integration": {
                "Drupal 11 compatibility for SendGrid reports settings form": "patches/sendgrid-integration-reports-drupal-11-config-form.patch"
            }
        }
    },
    "autoload": {
        "classmap": ["upstream-configuration/scripts/ComposerScripts.php"]
    },
    "scripts": {
        "pre-update-cmd": ["DrupalComposerManaged\\ComposerScripts::preUpdate"],
        "post-update-cmd": ["DrupalComposerManaged\\ComposerScripts::postUpdate"]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": false,
        "platform": {
            "php": "8.3.11"
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
