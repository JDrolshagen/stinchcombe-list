<?php

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function stinchcombe_content_types_install(): void {
  stinchcombe_content_types_create_organization_bundles();
  stinchcombe_content_types_create_accountability_record_bundles();
}

/**
 * Creates the accountability record content types for existing installations.
 */
function stinchcombe_content_types_update_11001(): string {
  stinchcombe_content_types_create_accountability_record_bundles();

  return 'Created the accountability record content types.';
}

/**
 * Creates the Police Oversight Agency content type.
 */
function stinchcombe_content_types_update_11002(): string {
  stinchcombe_content_types_create_organization_bundles();

  return 'Created the Police Oversight Agency content type.';
}

/**
 * Removes the organization type reference from Police Oversight Agency.
 */
function stinchcombe_content_types_update_11003(): string {
  $field_names = stinchcombe_content_types_find_entity_reference_fields_by_label(
    'law_enforcement_organization',
    'Type of Law Enforcement Organization',
  );
  stinchcombe_content_types_remove_fields(
    'police_oversight_agency',
    $field_names,
  );

  return 'Removed the Type of Law Enforcement Organization field from Police Oversight Agency.';
}
