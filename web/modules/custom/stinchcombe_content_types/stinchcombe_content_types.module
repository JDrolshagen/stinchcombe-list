<?php

declare(strict_types=1);

use Drupal\Core\Block\BlockPluginInterface;
use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\content_moderation\Plugin\WorkflowType\ContentModerationInterface;
use Drupal\field\FieldConfigInterface;
use Drupal\node\Entity\NodeType;

/**
 * Implements hook_form_FORM_ID_alter() for block configuration forms.
 */
function stinchcombe_content_types_form_block_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  $title_element = isset($form['settings']['views_label'])
    ? $form['settings']['views_label']
    : ($form['settings']['label'] ?? NULL);
  if ($title_element === NULL) {
    return;
  }

  $weight = ($title_element['#weight'] ?? 0) + 1;
  $fieldset = $title_element['#fieldset'] ?? NULL;
  $form['settings']['token_help_description'] = [
    '#markup' => '<p class="description">' . t(
      'Replacement tokens are supported. Available contextual tokens depend on the page where the block is displayed.',
    ) . '</p>',
    '#weight' => $weight,
  ];
  $form['settings']['token_help'] = [
    '#theme' => 'token_tree_link',
    '#token_types' => ['node', 'term', 'user'],
    '#global_types' => TRUE,
    '#weight' => $weight + 1,
  ];
  if ($fieldset !== NULL) {
    $form['settings']['token_help_description']['#fieldset'] = $fieldset;
    $form['settings']['token_help']['#fieldset'] = $fieldset;
  }
}

/**
 * Implements hook_block_view_alter().
 */
function stinchcombe_content_types_block_view_alter(
  array &$build,
  BlockPluginInterface $block,
): void {
  $label = (string) ($build['#configuration']['label'] ?? '');
  $is_views_block = $block->getBaseId() === 'views_block';
  if (!str_contains($label, '[') && !$is_views_block) {
    return;
  }

  // Add the varying contexts before Drupal checks the block render cache.
  // Replacement itself must happen after BlockViewBuilder::preRender(), which
  // is when Views adds its title to the content render array.
  $metadata = BubbleableMetadata::createFromRenderArray($build);
  $metadata->addCacheContexts(['route', 'url.site', 'user']);
  if (str_contains($label, '[')) {
    \Drupal::service('token')->replace(
      $label,
      stinchcombe_content_types_get_token_data(),
      ['clear' => FALSE],
      $metadata,
    );
  }
  $metadata->applyTo($build);
  $build['#pre_render'][] = 'stinchcombe_content_types_pre_render_block_tokens';
}

/**
 * Replaces tokens after the block plugin has built its content.
 */
function stinchcombe_content_types_pre_render_block_tokens(array $build): array {
  $metadata = BubbleableMetadata::createFromRenderArray($build);
  $metadata->addCacheContexts(['route', 'url.site']);
  $token = \Drupal::service('token');
  $token_data = stinchcombe_content_types_get_token_data();

  $label = (string) ($build['#configuration']['label'] ?? '');
  if (str_contains($label, '[')) {
    $build['#configuration']['label'] = $token->replace(
      $label,
      $token_data,
      ['clear' => FALSE],
      $metadata,
    );
  }

  $view_title = (string) ($build['content']['#title']['#markup'] ?? '');
  if (str_contains($view_title, '[')) {
    $build['content']['#title']['#markup'] = $token->replace(
      $view_title,
      $token_data,
      ['clear' => FALSE],
      $metadata,
    );
  }

  $metadata->applyTo($build);
  return $build;
}

/**
 * Returns token data for entities in the current route.
 */
function stinchcombe_content_types_get_token_data(): array {
  $token_data = [];

  // BigPipe can build lazy blocks before Domain's negotiation context has been
  // restored. Trigger negotiation so [current-domain:*] tokens can read it.
  if (\Drupal::moduleHandler()->moduleExists('domain')) {
    $domain = \Drupal::service('domain.negotiator')->getActiveDomain();
    if ($domain instanceof \Drupal\domain\DomainInterface) {
      $token_data['domain'] = $domain;
    }
  }

  foreach (\Drupal::routeMatch()->getParameters()->all() as $parameter) {
    if (!$parameter instanceof EntityInterface) {
      continue;
    }

    $entity_type = $parameter->getEntityTypeId();
    $token_type = $entity_type === 'taxonomy_term' ? 'term' : $entity_type;
    $token_data[$token_type] = $parameter;
  }

  return $token_data;
}

/**
 * Creates organization bundles based on Law Enforcement Organization.
 */
function stinchcombe_content_types_create_organization_bundles(): void {
  $bundles = [
    'judicial_council' => 'Judicial Council',
    'law_society' => 'Law Society',
    'prosecutors_offices' => "Prosecutors' Offices",
    'public_sector_integrity_office' => 'Public-Sector Integrity Office',
  ];

  stinchcombe_content_types_clone_bundles(
    'law_enforcement_organization',
    $bundles,
  );
}

/**
 * Creates accountability record bundles based on Officer Complaint.
 */
function stinchcombe_content_types_create_accountability_record_bundles(): void {
  $bundles = [
    'government_accountability_record' => 'Government Accountability Record',
    'judicial_conduct_determination' => 'Judicial Conduct Determination',
    'prosecutorial_misconduct_finding' => 'Prosecutorial Misconduct Finding',
  ];

  stinchcombe_content_types_clone_bundles('officer_complaint', $bundles);
}

/**
 * Creates bundles that inherit the configuration of a source node type.
 */
function stinchcombe_content_types_clone_bundles(
  string $source_bundle,
  array $bundles,
): void {
  $source_type = NodeType::load($source_bundle);

  if (!$source_type) {
    throw new RuntimeException(sprintf(
      'The source content type "%s" does not exist.',
      $source_bundle,
    ));
  }

  foreach ($bundles as $bundle => $label) {
    stinchcombe_content_types_clone_node_type($source_type, $bundle, $label);
    stinchcombe_content_types_clone_fields($source_bundle, $bundle);
    stinchcombe_content_types_clone_base_field_overrides($source_bundle, $bundle);
    stinchcombe_content_types_clone_displays($source_bundle, $bundle);
    stinchcombe_content_types_clone_language_settings($source_bundle, $bundle);
  }

  stinchcombe_content_types_clone_permissions($source_bundle, array_keys($bundles));
  stinchcombe_content_types_clone_moderation($source_bundle, array_keys($bundles));
}

/**
 * Clones bundle-specific overrides for node base fields.
 */
function stinchcombe_content_types_clone_base_field_overrides(
  string $source_bundle,
  string $target_bundle,
): void {
  $storage = \Drupal::entityTypeManager()->getStorage('base_field_override');
  $source_overrides = $storage->loadByProperties([
    'entity_type' => 'node',
    'bundle' => $source_bundle,
  ]);

  foreach ($source_overrides as $source_override) {
    $field_name = $source_override->getName();
    $id = "node.$target_bundle.$field_name";
    if ($storage->load($id)) {
      continue;
    }

    $values = $source_override->toArray();
    unset($values['uuid']);
    $values['id'] = $id;
    $values['bundle'] = $target_bundle;
    $storage->create($values)->save();
  }
}

/**
 * Clones the source node type's behavior under a new ID and label.
 */
function stinchcombe_content_types_clone_node_type(
  NodeType $source,
  string $bundle,
  string $label,
): void {
  if (NodeType::load($bundle)) {
    return;
  }

  $values = $source->toArray();
  unset($values['uuid']);
  $values['type'] = $bundle;
  $values['name'] = $label;

  NodeType::create($values)->save();
}

/**
 * Clones configurable fields from one node bundle to another.
 */
function stinchcombe_content_types_clone_fields(
  string $source_bundle,
  string $target_bundle,
): void {
  $field_definitions = \Drupal::service('entity_field.manager')
    ->getFieldDefinitions('node', $source_bundle);
  $field_storage = \Drupal::entityTypeManager()->getStorage('field_config');

  foreach ($field_definitions as $field_name => $definition) {
    if (!$definition instanceof FieldConfigInterface) {
      continue;
    }

    $id = "node.$target_bundle.$field_name";
    if ($field_storage->load($id)) {
      continue;
    }

    $values = $definition->toArray();
    unset($values['uuid']);
    $values['id'] = $id;
    $values['bundle'] = $target_bundle;
    $field_storage->create($values)->save();
  }
}

/**
 * Clones all form and view display modes for a node bundle.
 */
function stinchcombe_content_types_clone_displays(
  string $source_bundle,
  string $target_bundle,
): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $display_types = [
    'entity_form_display' => EntityFormDisplayInterface::class,
    'entity_view_display' => EntityViewDisplayInterface::class,
  ];

  foreach ($display_types as $entity_type_id => $interface) {
    $storage = $entity_type_manager->getStorage($entity_type_id);
    $source_displays = $storage->loadByProperties([
      'targetEntityType' => 'node',
      'bundle' => $source_bundle,
    ]);

    foreach ($source_displays as $source_display) {
      if (!$source_display instanceof $interface) {
        continue;
      }

      $mode = $source_display->getMode();
      $id = "node.$target_bundle.$mode";
      if ($storage->load($id)) {
        continue;
      }

      $values = $source_display->toArray();
      unset($values['uuid']);
      $values['id'] = $id;
      $values['bundle'] = $target_bundle;
      $storage->create($values)->save();
    }
  }
}

/**
 * Clones per-bundle content language settings when Language is enabled.
 */
function stinchcombe_content_types_clone_language_settings(
  string $source_bundle,
  string $target_bundle,
): void {
  if (!\Drupal::moduleHandler()->moduleExists('language')) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('language_content_settings');
  $source = $storage->load("node.$source_bundle");
  $target_id = "node.$target_bundle";

  if (!$source || $storage->load($target_id)) {
    return;
  }

  $values = $source->toArray();
  unset($values['uuid']);
  $values['id'] = $target_id;
  $values['target_bundle'] = $target_bundle;
  $storage->create($values)->save();
}

/**
 * Gives each role the same bundle-specific permissions as the source type.
 */
function stinchcombe_content_types_clone_permissions(
  string $source_bundle,
  array $target_bundles,
): void {
  $roles = \Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple();

  foreach ($roles as $role) {
    $source_permissions = array_filter(
      $role->getPermissions(),
      static fn(string $permission): bool => str_contains($permission, $source_bundle),
    );

    if (!$source_permissions) {
      continue;
    }

    foreach ($target_bundles as $target_bundle) {
      foreach ($source_permissions as $permission) {
        $role->grantPermission(str_replace($source_bundle, $target_bundle, $permission));
      }
    }
    $role->save();
  }
}

/**
 * Adds the new bundles to the source type's moderation workflow, if any.
 */
function stinchcombe_content_types_clone_moderation(
  string $source_bundle,
  array $target_bundles,
): void {
  if (!\Drupal::moduleHandler()->moduleExists('content_moderation')) {
    return;
  }

  $workflows = \Drupal::entityTypeManager()->getStorage('workflow')->loadMultiple();
  foreach ($workflows as $workflow) {
    $plugin = $workflow->getTypePlugin();
    if (
      !$plugin instanceof ContentModerationInterface ||
      !$plugin->appliesToEntityTypeAndBundle('node', $source_bundle)
    ) {
      continue;
    }

    foreach ($target_bundles as $target_bundle) {
      if (!$plugin->appliesToEntityTypeAndBundle('node', $target_bundle)) {
        $plugin->addEntityTypeAndBundle('node', $target_bundle);
      }
    }
    $workflow->save();
  }
}
