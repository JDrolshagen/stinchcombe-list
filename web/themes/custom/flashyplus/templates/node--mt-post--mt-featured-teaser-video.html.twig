{#
/**
 * @file
 * Flashy+'s theme implementation to display a Post node in featured teaser view mode.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('flashyplus/node-view-mode-featured-teaser-video') }}
{% set video = content.field_mt_pst_video %}
{% set pre_content_first = node.getCreatedTime|date('j M Y') %}
{% set pre_content_second = content.field_mt_pst_category %}
{% set rendered_content = content|without('field_mt_pst_video', 'field_mt_pst_category') %}
{% include '@flashyplus/partials/_mt-featured-teaser-video.html.twig' %}
